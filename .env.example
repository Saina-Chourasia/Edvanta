PORT=3000
JWT_SECRET=replace-with-a-secure-random-secret
NODE_ENV=development

# Database Configuration (PostgreSQL / Neon Serverless)
DATABASE_URL=postgresql://username:password@host-pooler.neon.tech/database?sslmode=require
PG_MAX_POOL=20

# Optional separate frontend URL for CORS (when deployed on Render + Vercel)
FRONTEND_URL=https://your-frontend.vercel.app

# AI Academic Assistant Configuration (Google Gemini / OpenAI)
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Google OAuth 2.0 / OpenID Connect Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_ALLOWED_EMAIL_1=
GOOGLE_ALLOWED_ROLE_1=STUDENT
GOOGLE_ALLOWED_EMAIL_2=
GOOGLE_ALLOWED_ROLE_2=STUDENT
GOOGLE_ALLOWED_EMAIL_3=
GOOGLE_ALLOWED_ROLE_3=STUDENT

# Telegram Academic Bot Configuration (Phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING=false

# Meta WhatsApp Business Platform Configuration (Phase 3)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
