# EDVANTA Production Environment Configuration Template
# COPY this template to your production hosting provider's Secret Environment Variables
# NEVER commit the filled production .env file to public source control.

# 1. Core Server Configuration
PORT=3000
NODE_ENV=production
# Generate a secure 64-char hex secret: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_char_hex_secret

# 2. Database Configuration (Neon Serverless PostgreSQL - Production Branch)
# Must use the pooled connection string (ep-...-pooler...neon.tech) with sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PROD_PASSWORD@ep-prod-branch-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 3. Google OAuth 2.0 / OpenID Connect Authentication
GOOGLE_CLIENT_ID=367016785449-gbleb45kcbicpvf5jcrblvvp3ejqog3m.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# IMPORTANT: Update to your exact production domain (must be added to Authorized Redirect URIs in Google Cloud Console)
GOOGLE_CALLBACK_URL=https://your-edvanta-domain.vercel.app/api/auth/google/callback
GOOGLE_ALLOWED_EMAIL_1=sainasakshi@gmail.com
GOOGLE_ALLOWED_ROLE_1=STUDENT
GOOGLE_ALLOWED_EMAIL_2=sainakumari32@gmail.com
GOOGLE_ALLOWED_ROLE_2=STUDENT
GOOGLE_ALLOWED_EMAIL_3=khushbukhantwal@gmail.com
GOOGLE_ALLOWED_ROLE_3=STUDENT
CRON_SECRET=replace_with_a_secure_random_cron_secret

# 4. AI Academic Assistant Configuration (Google Gemini)
AI_PROVIDER=gemini
AI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_MODEL_NAME=gemini-1.5-flash

# 5. Telegram Academic Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_POLLING=false

# 6. WhatsApp Business Platform (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
